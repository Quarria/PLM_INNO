PORT=3000
MEDIA_DIR=./data/media
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
BOOTSTRAP_ADMIN_NAME=系统管理员
